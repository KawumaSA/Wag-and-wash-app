SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-server-side-service-role-key
OWNER_EMAIL=jess@example.com
OWNER_PASSWORD=replace-with-a-unique-password
OWNER_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
CUSTOMER_CODE_HASH_SECRET=replace-with-a-separate-random-secret-at-least-32-characters
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
PAYPAL_CLIENT_ID=your-paypal-app-client-id
PAYPAL_CLIENT_SECRET=your-paypal-app-secret
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id
PAYPAL_MODE=sandbox

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=bookings@example.com
